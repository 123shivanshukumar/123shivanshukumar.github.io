# The URL the site will be built for
base_url = "https://123shivanshukumar.github.io"

# Whether to automatically compile all Sass files in the sass directory
compile_sass = true

# Whether to build a search index to be used later on by a JavaScript library
build_search_index = true


theme = "apollo"
taxonomies = [{ name = "tags" }]
[search]
include_title = true
include_description = true
include_path = true
include_content = true
index_format = "elasticlunr_json"
[markdown]
# Whether to do syntax highlighting
# Theme can be customised by setting the `highlight_theme` variable to a theme supported by Zola
[extra]
theme = "toggle"
menu = [
    { name = "Blog", url = "/posts", weight = 1 },
    { name = "Resources", url = "/projects", weight = 2 },
    { name = "About", url = "/about", weight = 3 },
    { name = "Tags", url = "/tags", weight = 3 },
    
]

socials = [
    { name = "twitter", url = "https://twitter.com/not_matthias", icon = "twitter" },
    { name = "github", url = "https://github.com/not-matthias/", icon = "github" },
]
fancy_code = true
dynamic_note = true
mathjax = true
mathjax_dollar_inline_enable = true
[extra.analytics]
enabled = true
